# AWS defaults (CLI flags override these)
AWS_PROFILE=
AWS_REGION=us-east-1

# Single account used for both VPCs and PHZs
VPCE_ACCOUNT=
# Or split: account owning the VPCs / account owning the PHZs (override VPCE_ACCOUNT)
VPCE_VPC_ACCOUNT=
VPCE_PHZ_ACCOUNT=
# Profiles per side (fall back to AWS_PROFILE)
VPCE_VPC_PROFILE=
VPCE_PHZ_PROFILE=
# Role to assume in target accounts when the profile's account differs
VPCE_ROLE_NAME=
VPCE_EXTERNAL_ID=
