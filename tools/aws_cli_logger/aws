# aws — logging wrapper for the AWS CLI
#
# Install as an executable named "aws" in a directory that comes before the
# real aws on PATH (e.g. ~/bin). Every invocation, its stdout/stderr (each line
# timestamped on arrival) and timing are appended to a log file that rolls over
# at 08:00 and 20:00 local time.
#
# Env overrides:
#   AWS_LOG_DIR            log directory                   (default ~/.aws/logs)
#   AWS_LOG_KEEP_DAYS      delete logs older than N days   (default 30, 0 = keep all)
#   AWS_LOG_COMPRESS_DAYS  gzip logs older than N days     (default 7, 0 = never)
#   AWS_REAL_BIN           path to the real aws            (default: next aws on PATH)
#   AWS_LOG_OUTPUT         redact (default) | none         (none = never log stdout/stderr)
#
# Secrets: values of secret-looking options (--password, --secret-string,
# --token-code, ...) are replaced by <redacted> in the logged command, and so are
# secret-valued keys (SecretAccessKey, SessionToken, SecretString, Password, ...)
# in output. The output of commands that return credentials (sts assume-role,
# secretsmanager get-secret-value, ssm get-parameter*, kms decrypt, ...) is not
# logged at all; stderr still is, redacted. Redaction is pattern-based and best
# effort: use AWS_LOG_OUTPUT=none when you can't accept any residual risk.
#
# Log line format:
#   [2026-10-30T09:14:02.113-0400] [3fa91c0e] START ... cmd: aws s3 ls
#   [2026-10-30T09:14:02.871-0400] [3fa91c0e] OUT 2026-01-04 12:00:00 my-bucket
#   [2026-10-30T09:14:02.902-0400] [3fa91c0e] END exit=0 duration_ms=789 last_output=2026-10-30T09:14:02.871-0400
# ENV lines (snapshot/set/changed/unset) record AWS_* changes in the calling
# shell, detected when its next aws command runs.
# The bracketed ID ties lines together when several shells log concurrently.

# --- make sure we're in bash 5+ ---------------------------------------------
# This block is plain POSIX sh so it still works if the script is started by
# /bin/sh, an old bash (macOS ships 3.2), or bash in POSIX mode. If so, try to
# re-run under a newer bash; failing that, pass straight through to aws.
case "${BASH_VERSINFO:-0}:${SHELLOPTS:-}" in
  [5-9]:*posix*|[1-4]:*|0:*) bash_ok=0 ;;
  *) bash_ok=1 ;;
esac
if [ "$bash_ok" = 0 ] && [ -z "${AWS_WRAPPER_REEXEC:-}" ]; then
  for b in /opt/homebrew/bin/bash /usr/local/bin/bash /usr/bin/bash /bin/bash; do
    if [ -x "$b" ] && "$b" -c '[ "${BASH_VERSINFO[0]}" -ge 5 ]' 2>/dev/null; then
      AWS_WRAPPER_REEXEC=1 exec "$b" "$0" "$@"
    fi
  done
fi

# --- locate the real aws (POSIX sh) -----------------------------------------
self=$(readlink -f -- "$0")
REAL_AWS=${AWS_REAL_BIN:-}
if [ -z "$REAL_AWS" ]; then
  save_ifs=$IFS; IFS=:
  for d in $PATH; do
    c="${d:-.}/aws"
    if [ -f "$c" ] && [ -x "$c" ] && [ "$(readlink -f -- "$c")" != "$self" ]; then
      REAL_AWS=$c; break
    fi
  done
  IFS=$save_ifs
fi
if [ ! -x "$REAL_AWS" ]; then
  echo "aws-wrapper: cannot find the real aws binary (set AWS_REAL_BIN)" >&2
  exit 127
fi

# Already inside the wrapper (e.g. a second copy on PATH, or aws calling aws
# via credential_process): don't log twice.
[ -z "${AWS_WRAPPER_ACTIVE:-}" ] || exec "$REAL_AWS" "$@"

# No suitable bash: get out of the way rather than break aws.
[ "$bash_ok" = 1 ] || [ -n "${AWS_WRAPPER_REEXEC:-}" ] || exec "$REAL_AWS" "$@"
[ -n "${EPOCHREALTIME:-}" ] || exec "$REAL_AWS" "$@"
unset AWS_WRAPPER_REEXEC
export AWS_WRAPPER_ACTIVE=1

# --- helpers ----------------------------------------------------------------
fmt_ts() {  # fmt_ts VAR EPOCH  -> 2026-10-30T09:14:02.113-0400
  local s=${2%%[.,]*} f=${2#*[.,]}
  printf -v "$1" '%(%Y-%m-%dT%H:%M:%S)T.%s%(%z)T' "$s" "${f:0:3}" "$s"
}
to_us() {   # to_us VAR EPOCH  -> integer microseconds
  local s=${2%%[.,]*} f=${2#*[.,]}
  printf -v "$1" '%d' $(( s * 1000000 + 10#$f ))
}
# --- secret redaction ---------------------------------------------------------
# Option names whose value is a secret, and the keys whose values are secrets in
# CLI output (JSON, YAML, key=value and table formats).
SECRET_OPT_RE='(secret|passw|token|credential|private-?key|key-?material)'
SECRET_KEY_RE='("?)([A-Za-z0-9_.-]*(secret|passw|token|private[_-]?key|key[_-]?material|plaintext)[A-Za-z0-9_.-]*)("?[[:space:]]*[:=|][[:space:]]*)("([^"\\]|\\.)*"|[^,}[:space:]|]+)'
SESSION_TOKEN_RE='(FwoG|IQoJ|AQoD|AQoE)[A-Za-z0-9/+=]{60,}'

redact_line() {  # redact_line VAR LINE -> VAR = LINE with secret values replaced
  local - ; shopt -s nocasematch
  local rest=$2 out= m pre q k sep v
  while [[ $rest =~ $SECRET_KEY_RE ]]; do
    m=${BASH_REMATCH[0]} q=${BASH_REMATCH[1]} k=${BASH_REMATCH[2]} sep=${BASH_REMATCH[4]} v=${BASH_REMATCH[5]}
    pre=${rest%%"$m"*}
    if [[ $k =~ (next|continuation|pagination|marker) ]]; then out+="$pre$m"
    elif [[ $v == \"* ]]; then out+="$pre$q$k$sep\"<redacted>\""
    else out+="$pre$q$k$sep<redacted>"
    fi
    rest=${rest#*"$m"}
  done
  rest=$out$rest
  out=
  while [[ $rest =~ $SESSION_TOKEN_RE ]]; do
    m=${BASH_REMATCH[0]}; out+="${rest%%"$m"*}<redacted>"; rest=${rest#*"$m"}
  done
  printf -v "$1" '%s' "$out$rest"
}

redact_args() {  # redact_args VAR ARGS... -> VAR = " %q %q ..." with secret option values replaced
  local - ; shopt -s nocasematch
  local var=$1 out= a name redact_next=0 cfg_pos=0; shift
  for a in "$@"; do
    if (( redact_next )); then out+=" '<redacted>'"; redact_next=0; continue; fi
    if [[ $a == --* ]]; then
      name=${a%%=*}
      if [[ $name =~ $SECRET_OPT_RE || ( $name == --value && $CMD_KEY == "ssm put-parameter" ) ]]; then
        if [[ $a == *=* ]]; then printf -v a ' %q=<redacted>' "$name"; out+=$a
        else printf -v a ' %q' "$name"; out+=$a; redact_next=1; fi
        continue
      fi
    elif [[ $CMD_KEY == "configure set" ]]; then   # aws configure set <name> <value>
      if (( cfg_pos == 2 )); then out+=" '<redacted>'"; cfg_pos=3; continue; fi
      [[ $a == set ]] && cfg_pos=1 || { (( cfg_pos == 1 )) && cfg_pos=2; }
    fi
    printf -v a ' %q' "$a"; out+=$a
  done
  printf -v "$var" '%s' "$out"
}

output_is_sensitive() {  # output_is_sensitive "<service> <command>": does stdout carry credentials?
  case "$1" in
    "sts assume-role"*|"sts get-session-token"|"sts get-federation-token"|"sts get-access-key-info"|\
    "secretsmanager get-secret-value"|"secretsmanager batch-get-secret-value"|"secretsmanager get-random-password"|\
    "ssm get-parameter"*|"kms decrypt"|"kms generate-data-key"*|"kms generate-random"|\
    "ecr get-login-password"|"ecr get-authorization-token"|"ecr-public get-login-password"|"ecr-public get-authorization-token"|\
    "codeartifact get-authorization-token"|"iam create-access-key"|"iam create-login-profile"|\
    "iam create-service-specific-credential"|"iam reset-service-specific-credential"|\
    "sso get-role-credentials"|"sso-oidc create-token"*|"cognito-identity get-credentials-for-identity"|\
    "cognito-identity get-open-id-token"*|"rds generate-db-auth-token"|"eks get-token"|\
    "redshift get-cluster-credentials"*|"configure export-credentials"|"configure get"|\
    "lightsail get-instance-access-details"|"ec2 get-password-data"|"ec2 create-key-pair"|\
    "iot create-keys-and-certificate"|"apigateway get-api-key"*|"s3 presign"|"s3api presign") return 0 ;;
  esac
  return 1
}

logline() { # logline EPOCH MESSAGE
  local ts; fmt_ts ts "$1"
  printf '[%s] [%s] %s\n' "$ts" "$ID" "$2" >&7
}
stream() {  # stream LABEL STATEFILE MODE — pass one stream through; log it (redacted) unless MODE=skip
  local label=$1 state=$2 mode=$3 line nl t ts shown last=
  while :; do
    if IFS= read -r line; then nl=$'\n'
    elif [[ -n $line ]]; then nl=          # final line with no newline
    else break; fi
    t=$EPOCHREALTIME
    printf '%s%s' "$line" "$nl"
    if [[ $mode != skip ]]; then
      fmt_ts ts "$t"
      redact_line shown "${line%$'\r'}"
      printf '[%s] [%s] %s %s\n' "$ts" "$ID" "$label" "$shown" >&7
    fi
    last=$t
    [[ -n $nl ]] || break
  done
  [[ -n $last ]] && printf '%s\n' "$last" > "$state"
}

maintain_logs() {  # gzip logs older than COMPRESS_DAYS, delete older than KEEP_DAYS
  # Ages are exact (minutes), not find's rounded -mtime days. A lock directory
  # stops two shells that rotate at the same moment from racing each other.
  local lock="$LOG_DIR/.maint.lock"
  find "$lock" -maxdepth 0 -mmin +60 -exec rmdir {} \; 2>/dev/null   # stale lock
  mkdir "$lock" 2>/dev/null || return 0
  trap 'rmdir "$lock" 2>/dev/null' EXIT

  if (( COMPRESS_DAYS > 0 )) && command -v gzip >/dev/null; then
    find "$LOG_DIR" -maxdepth 1 -type f -name 'aws-cli_*.log' \
      -mmin +$(( COMPRESS_DAYS * 1440 )) -exec gzip -q -9 {} + 2>/dev/null
  fi
  if (( KEEP_DAYS > 0 )); then
    find "$LOG_DIR" -maxdepth 1 -type f \( -name 'aws-cli_*.log' -o -name 'aws-cli_*.log.gz' \) \
      -mmin +$(( KEEP_DAYS * 1440 )) -delete 2>/dev/null
    find "$LOG_DIR/.env-state" -type f -mmin +$(( KEEP_DAYS * 1440 )) -delete 2>/dev/null
  fi
}

# --- pick the log file for the current 08:00/20:00 window -------------------
t0=$EPOCHREALTIME
now=${t0%%[.,]*}
printf -v hour '%(%H)T' "$now"; hour=$((10#$hour))
if   (( hour >= 20 )); then printf -v period '%(%Y-%m-%d)T_2000' "$now"
elif (( hour >= 8  )); then printf -v period '%(%Y-%m-%d)T_0800' "$now"
else                        printf -v period '%(%Y-%m-%d)T_2000' $(( now - 43200 ))  # yesterday 20:00
fi

LOG_DIR=${AWS_LOG_DIR:-$HOME/.aws/logs}
KEEP_DAYS=${AWS_LOG_KEEP_DAYS:-30}
COMPRESS_DAYS=${AWS_LOG_COMPRESS_DAYS:-7}
LOG="$LOG_DIR/aws-cli_${period}.log"

umask 077   # logs can contain secrets
mkdir -p -- "$LOG_DIR" 2>/dev/null || exec "$REAL_AWS" "$@"

if [[ ! -e $LOG ]]; then   # first command of a new window = rotation
  : >> "$LOG"
  ln -sfn -- "${LOG##*/}" "$LOG_DIR/aws-cli.log"   # stable name for tail -F
  maintain_logs </dev/null >/dev/null 2>&1 &   # compress/prune in the background; never delays aws
fi
{ exec 7>>"$LOG"; } 2>/dev/null || exec "$REAL_AWS" "$@"   # never block aws on logging

printf -v ID '%04x%04x' "$RANDOM" "$RANDOM"

# --- commands that need a real terminal: log start/end only -----------------
interactive=0
words=() skip=0
for a in "$@"; do
  if (( skip )); then skip=0; continue; fi
  case $a in
    --profile|--region|--output|--endpoint-url|--query|--ca-bundle|--color|\
    --cli-read-timeout|--cli-connect-timeout|--cli-binary-format) skip=1 ;;
    -*) ;;
    *) words+=("$a"); (( ${#words[@]} == 2 )) && break ;;
  esac
done
CMD_KEY="${words[0]-} ${words[1]-}"
case "$CMD_KEY" in
  "configure "|"configure sso"*|"ssm start-session"|"ecs execute-command") interactive=1 ;;
esac
[[ " $* " == *" --cli-auto-prompt "* || ${AWS_CLI_AUTO_PROMPT:-} == on* ]] && interactive=1
[[ ${!#} == help ]] && interactive=1

# --- what to log: the redacted command, and stdout/stderr unless suppressed ----
redact_args cmdline "$@"
OUT_MODE=log ERR_MODE=log output_note=
case ${AWS_LOG_OUTPUT:-redact} in
  none) OUT_MODE=skip ERR_MODE=skip output_note=' output=off(AWS_LOG_OUTPUT=none)' ;;
  *) if output_is_sensitive "$CMD_KEY"; then OUT_MODE=skip output_note=' stdout=suppressed(sensitive-command)'; fi ;;
esac

# --- AWS_* environment tracking (per calling shell) ---------------------------
# Snapshot exported AWS_* vars, diff against what this shell had at its last
# aws command, log the differences. Secrets are logged as a short hash so you
# can see that they changed without the value landing in the log.
declare -A cur=() old=()
for n in $(compgen -e); do
  [[ $n == AWS_* ]] || continue
  case $n in AWS_LOG_*|AWS_REAL_BIN|AWS_WRAPPER_*) continue ;; esac
  v=${!n}
  case $n in
    *SECRET*|*TOKEN*|*PASSWORD*)
      h=$(printf '%s' "$v" | { sha256sum 2>/dev/null || shasum -a 256; } | cut -c1-8)
      v="<redacted sha256:$h len:${#v}>" ;;
    *) printf -v v '%q' "$v" ;;
  esac
  cur[$n]=$v
done

# Key the state on the parent shell's PID + start time (guards against PID reuse)
pstart=$(ps -o lstart= -p "$PPID" 2>/dev/null); pstart=${pstart//[^0-9A-Za-z]/}
STATE_DIR="$LOG_DIR/.env-state"
mkdir -p -- "$STATE_DIR" 2>/dev/null
state="$STATE_DIR/${PPID}_${pstart:-unknown}"

oldperiod=
if [[ -r $state ]]; then
  { IFS= read -r oldperiod
    while IFS= read -r l; do old[${l%%=*}]=${l#*=}; done; } < "$state"
fi

env_lines=()
mapfile -t names < <(printf '%s\n' "${!cur[@]}" "${!old[@]}" | grep . | sort -u)
if [[ $oldperiod != "$period" ]]; then
  # New shell, or first command of this shell in a new log file: full snapshot
  snap=
  for n in "${names[@]}"; do [[ -n ${cur[$n]+x} ]] && snap+=" $n=${cur[$n]}"; done
  env_lines+=("ENV snapshot shell=$PPID${snap:- (no AWS_* vars)}")
else
  for n in "${names[@]}"; do
    if   [[ -z ${old[$n]+x} ]]; then env_lines+=("ENV set $n=${cur[$n]}")
    elif [[ -z ${cur[$n]+x} ]]; then env_lines+=("ENV unset $n (was ${old[$n]})")
    elif [[ ${old[$n]} != "${cur[$n]}" ]]; then env_lines+=("ENV changed $n: ${old[$n]} -> ${cur[$n]}")
    fi
  done
fi

{ printf '%s\n' "$period"
  for n in "${!cur[@]}"; do printf '%s=%s\n' "$n" "${cur[$n]}"; done
} > "$state.$$" 2>/dev/null && mv -f -- "$state.$$" "$state" 2>/dev/null

logline "$t0" "START shell=$PPID user=${USER:-$(id -un)} host=${HOSTNAME} cwd=${PWD} profile=${AWS_PROFILE:--} region=${AWS_REGION:-${AWS_DEFAULT_REGION:--}}$( ((interactive)) && echo ' mode=interactive(output-not-captured)')${output_note} cmd: aws${cmdline}"
for l in "${env_lines[@]}"; do logline "$t0" "$l"; done

trap ':' INT   # let aws handle Ctrl-C; we still write END

if (( interactive )); then
  "$REAL_AWS" "$@" 7>&-
  rc=$?
  t1=$EPOCHREALTIME
  last_ts=n/a
else
  tmp=$(mktemp -d) || exit 1
  trap 'rm -rf -- "$tmp"' EXIT
  export AWS_PAGER=""   # output is piped; never invoke less

  {
    "$REAL_AWS" "$@" 2>&1 >&3 3>&- 7>&- | stream ERR "$tmp/err" "$ERR_MODE" >&2 3>&-
    printf '%s\n' "${PIPESTATUS[0]}" > "$tmp/rc"
  } 3>&1 | stream OUT "$tmp/out" "$OUT_MODE"

  t1=$EPOCHREALTIME
  if [[ -s $tmp/rc ]]; then read -r rc < "$tmp/rc"; else rc=130; fi

  # last output = later of the last stdout line and the last stderr line
  last= ; last_us=0
  for f in "$tmp/out" "$tmp/err"; do
    [[ -s $f ]] || continue
    read -r t < "$f"; to_us u "$t"
    (( u > last_us )) && { last=$t; last_us=$u; }
  done
  if [[ -n $last ]]; then fmt_ts last_ts "$last"; else last_ts=none; fi
fi

to_us a "$t0"; to_us b "$t1"
logline "$t1" "END exit=$rc duration_ms=$(( (b - a) / 1000 )) last_output=$last_ts"
exit "$rc"