# AWS profile (overridden by --profile). Never written into reports.
AWS_PROFILE=
# Region of the security group (overridden by --region).
# Falls back to AWS_REGION / AWS_DEFAULT_REGION.
SGE_REGION=us-east-1
# Root folder for HTML reports (<dir>/<YYYY-MM-DD>/<account>/...)
SGE_REPORTS_DIR=reports
# Default HTML report theme: dark | light | auto (follow OS)
SGE_THEME=dark
