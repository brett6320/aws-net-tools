# AWS profile (overridden by --profile). Never written into backups.
AWS_PROFILE=
# Region to read, and the Direct Connect API Region (overridden by --region).
# Falls back to AWS_REGION / AWS_DEFAULT_REGION.
DXB_REGION=us-east-1
# Read several Regions instead (comma-separated; overridden by --regions)
DXB_REGIONS=
# Root folder for backups (<dir>/<account>/<UTC timestamp>/)
DXB_BACKUP_DIR=backups
# Root folder for diff reports (<dir>/<YYYY-MM-DD>/<account>/...)
DXB_REPORTS_DIR=reports
# Default HTML report theme: dark | light | auto (follow OS)
DXB_THEME=dark
