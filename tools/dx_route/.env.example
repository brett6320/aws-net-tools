# AWS profile (overridden by --profile). Never written into reports.
AWS_PROFILE=
# Region whose VIFs to read, and the Direct Connect API Region (overridden by --region).
# Falls back to AWS_REGION / AWS_DEFAULT_REGION.
DXR_REGION=us-east-1
# Read the VIFs of several Regions instead (comma-separated; overridden by --regions)
DXR_REGIONS=
# Region the traffic leaves from, for the default local preference (overridden by --from-region;
# defaults to the first Region read)
DXR_FROM_REGION=
# Only this Direct Connect gateway's VIFs, in any Region or account (overridden by --dx-gateway)
DXR_DX_GATEWAY=
# Root folder for HTML reports (<dir>/<YYYY-MM-DD>/<scope>/...)
DXR_REPORTS_DIR=reports
# Default HTML report theme: dark | light | auto (follow OS)
DXR_THEME=dark
