# VPC owner map written by ou_vpcs (default ~/.cache/aws-net-tools/vpc-owners.json;
# OU_VPCS_CACHE is used when this is unset). Never stored in the repository.
VPC_PART_CACHE=
# Profile for Organizations (management or delegated-administrator account), to expand OU and
# organization principals to their accounts (overridden by --org-profile; falls back to OU_VPCS_ORG_PROFILE)
VPC_PART_ORG_PROFILE=
# Profile names never used for owner accounts (comma-separated suffixes)
VPC_PART_PROFILE_EXCLUDE_SUFFIXES=-priv,-adm,-cpar,-ro
