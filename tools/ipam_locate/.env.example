# AWS profile for the IPAM owner / delegated administrator account (overridden by --profile).
# Never written into reports.
AWS_PROFILE=
# IPAM home Region (overridden by --region). Falls back to AWS_REGION / AWS_DEFAULT_REGION.
IPAM_REGION=us-east-1
# IPAM to use when the home Region has more than one (overridden by --ipam-id)
IPAM_ID=
# Root folder for HTML reports (<dir>/<YYYY-MM-DD>/<account-id>/...)
IPAM_REPORTS_DIR=reports
# Default HTML report theme: dark | light | auto (follow OS)
IPAM_THEME=dark
