# AWS profile (overridden by --profile). Never written into exports.
AWS_PROFILE=
# Region (overridden by --region). Falls back to the profile's region.
AWS_REGION=us-east-1
# Seconds to wait for an analysis with --wait/--export (default 600)
RA_WAIT_TIMEOUT=600
# Root folder for HTML reports (<dir>/<YYYY-MM-DD>/<account-id>/...)
RA_REPORTS_DIR=reports
# Default HTML report theme: dark | light | auto (follow OS)
RA_THEME=dark
