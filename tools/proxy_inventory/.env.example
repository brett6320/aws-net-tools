# VPC owner map written by ou_vpcs (default ~/.cache/aws-net-tools/vpc-owners.json;
# OU_VPCS_CACHE is used when this is unset). Never stored in the repository.
PROXY_INV_CACHE=
# Only VPCs of accounts in these OUs (OU IDs, or OU paths such as Root/Prod), comma-separated (overridden by --ou)
PROXY_INV_OU=
# Only VPCs in these Regions, comma-separated (overridden by --regions)
PROXY_INV_REGIONS=
# Tag that identifies the application, matched without regard to case (overridden by --key-tag; default AppCatID)
PROXY_INV_KEY_TAG=
# Accounts read in parallel (overridden by --workers; default 4)
PROXY_INV_WORKERS=
# Reports root (overridden by --reports-dir; default ./reports)
PROXY_INV_REPORTS_DIR=
# Profile names never used for accounts (comma-separated suffixes)
PROXY_INV_PROFILE_EXCLUDE_SUFFIXES=-priv,-cpar
