# Profile for the Organizations calls: management or delegated-administrator account
# (overridden by --profile; falls back to AWS_PROFILE)
OU_VPCS_ORG_PROFILE=
# OU(s) to list, comma-separated (overridden by --ou)
OU_VPCS_OU=
# Regions scanned in each account (overridden by --regions; default us-east-1,ca-central-1)
OU_VPCS_REGIONS=
# Profile names never used for member accounts (comma-separated suffixes)
OU_VPCS_PROFILE_EXCLUDE_SUFFIXES=-priv,-cpar
# VPC owner map shared with phz_review (default ~/.cache/aws-net-tools/vpc-owners.json;
# VPCE_OWNER_CACHE is used when this is unset). Never stored in the repository.
OU_VPCS_CACHE=
