# AWS_PROFILE=hcli-network-ro   # optional; standard boto3 credential chain when unset
AWS_REGION=us-east-1
# CWAH_ALARMS=net-dx-bgp-down,net-tgw-packet-drops   # comma-separated alarm names
# CWAH_ALARMS_FILE=alarms.txt    # one alarm name per line
# CWAH_LAST=7d                   # window ending at CWAH_END (not with CWAH_START)
# CWAH_START=2026-11-01T00:00Z   # ISO 8601 (naive = local time) or a duration ago (36h)
# CWAH_END=now
# CWAH_HISTORY_TYPES=StateUpdate # StateUpdate, ConfigurationUpdate, Action or all
# CWAH_ALARM_TYPES=MetricAlarm,CompositeAlarm
# CWAH_OUT_DIR=reports
# CWAH_FORMATS=html              # html, csv, json
# CWAH_THEME=dark                # dark, light or auto
# CWAH_NO_TRUSTSTORE=1           # only if truststore misbehaves
